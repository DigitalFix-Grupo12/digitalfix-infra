# Copiar a .env (NO se sube al repo). Valores de DESARROLLO LOCAL: coinciden con
# los defaults de los microservicios. En la nube (ec2-mq) el .env se genera con
# credenciales aleatorias desde SSM Parameter Store (ver Deploy-MQ.ps1).
RABBITMQ_USER=digitalfix
RABBITMQ_PASS=digitalfix
# Cookie de Erlang: identico en ambos nodos, solo letras/numeros (20+ caracteres)
RABBITMQ_ERLANG_COOKIE=DIGITALFIXCLUSTERCOOKIE2026
